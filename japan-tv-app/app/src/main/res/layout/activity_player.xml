<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- 영상 위를 덮어서, 누르면 메뉴 / 좌우로 밀면 채널 변경 -->
    <View
        android:id="@+id/touchLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/statusBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_status"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/statusProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@android:color/white" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/statusButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatusNext"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/next_channel"
                android:textColor="@android:color/white"
                app:strokeColor="#99FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_status"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="@string/hint_unmute"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- 앱이 직접 그리는 자막: 일본어 + 한국어(구글 번역) -->
    <LinearLayout
        android:id="@+id/captionBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_caption"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/capJa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:textColor="@android:color/white"
            android:textSize="19sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/capKo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:textColor="#FFFFE07A"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/capNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 화면을 누르면 나오는 메뉴 -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_gradient_top"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/channelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:shadowColor="#FF000000"
                        android:shadowRadius="4"
                        android:singleLine="true"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/videoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:shadowColor="#FF000000"
                        android:shadowRadius="4"
                        android:singleLine="true"
                        android:textColor="#CCFFFFFF"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnReload"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_reload"
                    android:src="@drawable/ic_refresh" />

                <ImageButton
                    android:id="@+id/btnRotate"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_rotate"
                    android:src="@drawable/ic_screen_rotation" />

                <ImageButton
                    android:id="@+id/btnPip"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_pip"
                    android:src="@drawable/ic_pip" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="52dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnCc"
                        style="@style/OverlayChip" />

                    <TextView
                        android:id="@+id/btnAlt"
                        style="@style/OverlayChip"
                        android:text="@string/other_live" />

                    <TextView
                        android:id="@+id/btnPage"
                        style="@style/OverlayChip" />

                    <TextView
                        android:id="@+id/btnTouch"
                        style="@style/OverlayChip"
                        android:text="@string/direct_touch" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_gradient_bottom"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="32dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_round_dark"
                android:contentDescription="@string/cd_prev"
                android:src="@drawable/ic_skip_previous" />

            <TextView
                android:id="@+id/swipeHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:gravity="center"
                android:shadowColor="#FF000000"
                android:shadowRadius="4"
                android:text="@string/swipe_hint"
                android:textColor="#DDFFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/vodControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnRew"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_rew"
                    android:src="@drawable/ic_fast_rewind" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_round_dark"
                    android:contentDescription="@string/cd_play_pause"
                    android:src="@drawable/ic_pause" />

                <ImageButton
                    android:id="@+id/btnFwd"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_fwd"
                    android:src="@drawable/ic_fast_forward" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_round_dark"
                android:contentDescription="@string/cd_next"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>
    </FrameLayout>

    <!-- 웹 페이지 모드에서만: 메뉴 열기 버튼 -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/bg_round_dark"
        android:contentDescription="@string/cd_menu"
        android:src="@drawable/ic_menu"
        android:visibility="gone" />
</FrameLayout>
