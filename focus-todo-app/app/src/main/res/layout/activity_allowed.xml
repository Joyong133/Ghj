<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="전화, 문자, 연락처 앱은 항상 허용돼요.\n카카오톡처럼 집중 중에도 써야 하는 앱이 있으면 체크하세요."
        android:textColor="@color/text_sub"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/allowedLocked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/warn_bg"
        android:padding="12dp"
        android:text="🔒 지금은 집중 시간이라 허용 앱을 바꿀 수 없어요."
        android:textColor="@color/warn_text"
        android:visibility="gone" />

    <ListView
        android:id="@+id/appList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_bg" />
</LinearLayout>
