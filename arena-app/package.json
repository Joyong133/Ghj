{
  "name": "arena-app",
  "productName": "Arena",
  "version": "1.0.0",
  "description": "arena.ai를 브라우저 없이 바로 여는 데스크톱 앱 (저장한 프롬프트, 답변 분량, 스르륵, 고정 모드)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync-web": "node scripts/sync-web.js",
    "prestart": "node scripts/sync-web.js",
    "start": "electron .",
    "predist": "node scripts/sync-web.js",
    "dist": "electron-builder",
    "dist:win": "node scripts/sync-web.js && electron-builder --win",
    "dist:mac": "node scripts/sync-web.js && electron-builder --mac",
    "dist:linux": "node scripts/sync-web.js && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.joyong133.arena",
    "productName": "Arena",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "web/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arena",
      "artifactName": "Arena-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Arena-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Arena-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "joyong133",
      "artifactName": "Arena-${version}.${ext}"
    }
  }
}
